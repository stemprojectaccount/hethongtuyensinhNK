{
  "entities": {
    "Submission": {
      "title": "Submission",
      "description": "A student enrollment submission containing personal info and grades.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The Firebase Auth UID of the user who created this submission."
        },
        "fullName": {
          "type": "string"
        },
        "dob": {
          "type": "string"
        },
        "gender": {
          "type": "string"
        },
        "school": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "parentPhone": {
          "type": "string"
        },
        "grades": {
          "type": "object",
          "properties": {
            "1": { "type": "string" },
            "2": { "type": "string" },
            "3": { "type": "string" },
            "4": { "type": "string" },
            "5": { "type": "string" }
          },
          "required": ["1", "2", "3", "4", "5"]
        },
        "totalScore": {
          "type": "number"
        },
        "createdAt": {
          "type": "timestamp",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "timestamp"
        }
      },
      "required": ["userId", "fullName", "dob", "gender", "school", "address", "parentPhone", "grades", "totalScore", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/Submission" },
      "description": "Stores user enrollment submissions."
    }
  }
}
